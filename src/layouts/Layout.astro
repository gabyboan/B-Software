---
import "../styles/global.css";
import NavBar from "../components/NavBar.astro";
import Footer from "../components/Footer.astro";
import "../styles/refresh.css";
import "@fontsource-variable/inter";
import "../styles/professional.css";
import "../styles/case-motion.css";

const {
  title = "B-Software | Sistemas internos, Flutter y automatizaciones",
  description = "Desarrollo de sistemas internos, aplicaciones Flutter, automatizaciones e integraciones con Supabase y PostgreSQL, seguridad, QA y despliegue.",
  canonical = "https://bsoftware.pages.dev/",
  image = "https://bsoftware.pages.dev/b-software-hero.png",
  imageAlt = "B-Software, desarrollo de sistemas internos, aplicaciones móviles y automatizaciones",
  imageWidth = 1693,
  imageHeight = 929,
  ogType = "website",
  bodyClass = "",
  navVariant = "compact",
  noindex = false,
} = Astro.props;
---

<!doctype html>
<html lang="es-AR" data-language="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? "noindex, follow" : "index, follow, max-image-preview:large"} />
    <meta name="author" content="B-Software" />
    <meta name="creator" content="B-Software" />
    <meta name="publisher" content="B-Software" />
    <meta name="google-site-verification" content="5XXAuKK8zHCTKb-elXLOMZ_nPPh1vvYtPUw-3oY1a_A" />
    <meta name="keywords" content="B-Software, desarrollo Flutter, Supabase, sistemas internos, software empresarial, aplicaciones moviles, automatizaciones, PostgreSQL, integraciones, desarrollo a medida" />
    <meta name="theme-color" content="#111111" />
    <link rel="canonical" href={canonical} />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="B-Software" />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:locale:alternate" content="en_US" />
    <meta property="og:image" content={image} />
    <meta property="og:image:secure_url" content={image} />
    <meta property="og:image:width" content={String(imageWidth)} />
    <meta property="og:image:height" content={String(imageHeight)} />
    <meta property="og:image:alt" content={imageAlt} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <meta name="twitter:image:alt" content={imageAlt} />

    <link rel="icon" type="image/x-icon" sizes="16x16 32x32 48x48" href="/favicon.ico?v=brand-circle-2" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon.png?v=brand-circle-2" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png?v=brand-b-1" />
    <link rel="sitemap" href="/sitemap.xml" />
    <title>{title}</title>
    <script is:inline>
      (() => {
        const requested = new URLSearchParams(location.search).get("lang");
        let saved;
        try { saved = localStorage.getItem("bsoftware-language"); } catch {}
        const preferred = navigator.languages?.[0] || navigator.language || "es";
        const language = requested === "en" || requested === "es"
          ? requested
          : saved === "en" || saved === "es"
            ? saved
            : preferred.toLowerCase().startsWith("es") ? "es" : "en";
        window.__bsoftwareLanguage = language;
        document.documentElement.lang = language === "en" ? "en" : "es-AR";
        document.documentElement.dataset.language = language;
      })();
    </script>
  </head>
  <body class={bodyClass}>
    <a class="skip-link" href="#main-content">Saltar al contenido</a>
    <NavBar variant={navVariant} />
    <div id="main-content" tabindex="-1"><slot /></div>
    <Footer />
    <script>
      import "../scripts/language";
    </script>
  </body>
</html>
