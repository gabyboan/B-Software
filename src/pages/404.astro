---
import Layout from "../layouts/Layout.astro";
---
<Layout title="Página no encontrada | B-Software" description="Encontrá los proyectos, servicios y canales de contacto de B-Software." canonical="https://bsoftware.pages.dev/404" noindex navVariant="compact">
  <main class="not-found"><p class="eyebrow">Error 404</p><h1>Esta página no está disponible.</h1><p>Podés volver al inicio, explorar los proyectos o contarme qué necesitás resolver.</p><div class="hero-actions"><a class="button primary" href="/">Volver al inicio</a><a class="button secondary" href="/contacto/">Contacto</a></div></main>
</Layout>
<style>.not-found { max-width:1180px; margin:auto; padding:90px 20px 120px; min-height:60vh; }.not-found p:not(.eyebrow) { margin-top:24px; max-width:680px; color:var(--muted); line-height:1.8; }</style>
